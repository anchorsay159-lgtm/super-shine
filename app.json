{
  "expo": {
    "name": "Super Shine",
    "slug": "super-shine",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "supershine",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.supershine.studentapp",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071C2B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Super Shine to select laundry photos and payment slips."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Super Shine to save your PromptPay QR.",
          "savePhotosPermission": "Allow Super Shine to save your PromptPay QR."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Super Shine to use your location while you are completing an active pickup or delivery task."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDF9F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3e43388a-a564-410a-b728-37a52e2e6f52"
      }
    }
  }
}
